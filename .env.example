# Copy to `.env.local` (Git-ignored) and fill in your upstream LLM API key.
# Never commit real credentials.

# ── Upstream OpenAI-compatible LLM (DeepSeek / OpenAI / OpenRouter / Ollama) ──
HMPH_DEEPSEEK_API_KEY=
HMPH_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
HMPH_DEEPSEEK_MODEL=deepseek-chat

# Or use generic OpenAI-compatible overrides (highest priority):
# HMPH_LOCAL_API_KEY=
# HMPH_LOCAL_BASE_URL=https://api.openai.com/v1
# HMPH_LOCAL_MODEL=gpt-4o-mini

# ── Optional: Gateway Security & Episode Segmentation ──
# Set HMPH_GATEWAY_API_KEY when exposing the gateway on LAN/NAS (leave empty for zero-config localhost)
# HMPH_GATEWAY_API_KEY=
# Idle gap in minutes before rolling AIRI default sessions into a new auto-summarized episode (default: 45)
# HMPH_SESSION_IDLE_MINUTES=45

# ── Optional: Cloud/Local Embedding Override (defaults to offline ONNX MiniLM) ──
# HMPH_EMBEDDING_API_KEY=
# HMPH_EMBEDDING_BASE_URL=
# HMPH_EMBEDDING_MODEL=
# HMPH_DISABLE_LOCAL_ONNX=0

# ── Optional: Cross-Encoder / Reranker API ──
# HMPH_RERANK_API_KEY=
# HMPH_RERANK_BASE_URL=
# HMPH_RERANK_MODEL=
